    "url": "https://personnummer.dev"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "personnummer": "^3.3.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "funding": {
    "type": "opencollective",
